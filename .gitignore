# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# mapeamento do acervo real — contém nomes de clientes e de arquivos reais.
# Serve de insumo para o desenho da estrutura, mas é dado de cliente: fica fora
# do repositório.
arvore_effective_bpo.txt
mapear_estrutura_effective_bpo.py
/mapeamento/
*_estrutura_*.txt

# credenciais de integração — NUNCA versionar
# O Google Cloud entrega o OAuth client como .json; baixar na pasta do projeto
# é o caminho natural e o jeito mais fácil de vazar segredo por engano.
client_secret*.json
credentials*.json
token*.json
*-oauth.json
/tokens/
/segredos/
*.pem
*.p12
*.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
