# OpenAI
GPT_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5.5
# Só necessário pra alguns modelos (ex: gpt-5.6-sol) que exigem isso pra
# aceitar function tools em /v1/chat/completions. Valores:
# none|minimal|low|medium|high|xhigh|max
OPENAI_REASONING_EFFORT=

# Supabase (Settings > API no painel do projeto)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nunca exponha esta chave no cliente: só é usada nas Route Handlers (servidor).
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Drive — OAuth 2.0 com conta Google HUMANA (não use conta de serviço).
#
# Onde obter: console.cloud.google.com > APIs e Serviços > Credenciais >
# Criar credencial > ID do cliente OAuth > Aplicativo da Web.
# Em "URIs de redirecionamento autorizados", cadastre exatamente o valor de
# GOOGLE_DRIVE_REDIRECT_URI abaixo.
#
# NUNCA versione estes valores. Coloque-os em .env.local (ignorado pelo Git).
# Nenhuma delas pode virar NEXT_PUBLIC_ — são segredos de servidor.
GOOGLE_DRIVE_AUTH_MODE=oauth
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/integracoes/google-drive/callback

# Preenchido pelo fluxo em /integracoes/google-drive (mostrado uma única vez).
GOOGLE_DRIVE_REFRESH_TOKEN=

# Preenchido por: npm run drive:bootstrap
GOOGLE_DRIVE_PASTA_RAIZ_ID=
