# OpenAI
GPT_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5.5
# Só necessário pra alguns modelos (ex: gpt-5.6-sol) que exigem isso pra
# aceitar function tools em /v1/chat/completions. Deixe vazio se o modelo
# funcionar sem essa variável. Valores: none|minimal|low|medium|high|xhigh|max
OPENAI_REASONING_EFFORT=

# Supabase (Settings > API no painel do projeto)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nunca exponha esta chave no cliente: só é usada nas Route Handlers (servidor).
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
